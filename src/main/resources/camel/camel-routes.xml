<?xml version="1.0" encoding="UTF-8"?>
<camel xmlns="http://camel.apache.org/schema/spring"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://camel.apache.org/schema/spring https://camel.apache.org/schema/spring/camel-spring.xsd">

    <rest path="/xml">
        <post path="/files">
            <to uri="direct:saveXmlToFile"/>
        </post>
    </rest>

    <route id="saveXmlToFileRoute">
        <from uri="direct:saveXmlToFile"/>
        
        <log message="Received a request to save tontent to file. Checking query param 'content'"/>

        <setBody>
            <header>content</header>
        </setBody>

        <choice>
            <!-- validation -->
            <when>
                <simple>${body} == null</simple>
                <log loggingLevel="WARN" message="Validation failed: 'content' query parameter is missing"/>
                <setBody>
                    <constant>'content' query parameter is missing</constant>
                </setBody>
                <setHeader name="CamelHttpResponseCode">
                    <constant>400</constant>
                </setHeader>
            </when>
            
            <!-- file processing -->
            <otherwise>
                <choice>
                    <when>
                        <simple>${header.fileName} != null</simple>
                        <log message="The recognized filename is: ${header.fileName}"/>
                        <setProperty name="generatedFileName">
                            <simple>${header.fileName}</simple>
                        </setProperty>
                    </when>
                    <otherwise>
                        <log message="Generating the file name based on date and time"/>
                        <setProperty name="generatedFileName">
                            <simple>${date:now:yyyyMMdd-HHmmss}.txt</simple>
                        </setProperty>
                    </otherwise>
                </choice>

				<!-- file storing -->
                <toD uri="file:{{app.output.dir}}?fileName=${exchangeProperty.generatedFileName}&amp;fileExist=Override"/>
                <setBody>
                    <simple>A new file was stored as ${exchangeProperty.generatedFileName}</simple>
                </setBody>
                <setHeader name="CamelHttpResponseCode">
                    <constant>200</constant>
                </setHeader>
            </otherwise>
        </choice>
    </route>

</camel>