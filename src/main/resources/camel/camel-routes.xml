<?xml version="1.0" encoding="UTF-8"?>
<camel xmlns="http://camel.apache.org/schema/spring"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://camel.apache.org/schema/spring https://camel.apache.org/schema/spring/camel-spring.xsd">

    <!-- Definice REST endpointů je nyní uvnitř elementu <camel> zcela validní -->
    <rest path="/files">
        <post path="/xml">
            <to uri="direct:saveXmlToFile"/>
        </post>
    </rest>

    <!-- Samotná trasa -->
    <route id="saveXmlToFileRoute">
        <from uri="direct:saveXmlToFile"/>
        
        <log message="Prijat pozavek na /files/xml. Overuji parametr 'ctnt'."/>

        <setBody>
            <header>ctnt</header>
        </setBody>

        <choice>
            <!-- 1. Validace: Pokud chybí parametr 'cnt' -->
            <when>
                <simple>${body} == null</simple>
                <log loggingLevel="WARN" message="Validace selhala: Chybi parametr 'ctnt'."/>
                <setBody>
                    <constant>Chybi povinny query parametr 'ctnt'</constant>
                </setBody>
                <setHeader name="CamelHttpResponseCode">
                    <constant>400</constant>
                </setHeader>
            </when>
            
            <!-- 2. Zpracování a zápis souboru -->
            <otherwise>
                <choice>
                    <!-- Pokud uživatel zadal parametr 'fileName' -->
                    <when>
                        <simple>${header.fileName} != null</simple>
                        <log message="Bude pouzit uzivatelsky nazev souboru: ${header.fileName}"/>
                        <setHeader name="CamelOverruleFileName">
                            <simple>${header.fileName}</simple>
                        </setHeader>
                    </when>
                    <!-- Pokud parametr 'fileName' chybi, pouzije se datum a cas -->
                    <otherwise>
                        <log message="Parametr 'fileName' nebyl zadan, generuji nazev podle data a casu."/>
                        <setHeader name="CamelOverruleFileName">
                            <simple>${date:now:yyyyMMdd-HHmmss}.txt</simple>
                        </setHeader>
                    </otherwise>
                </choice>

                <log message="Zapisuji obsah do adresare: {{app.output.dir}} s nazvem: ${header.CamelOverruleFileName}"/>
                
                <!-- Zápis na disk -->
                <toD uri="file:{{app.output.dir}}?fileExist=Override"/>

                <!-- Úspěšná odpověď -->
                <log message="Soubor byl uspesne zapsan."/>
                <setBody>
                    <simple>Soubor byl uspesne ulozen jako: ${header.CamelOverruleFileName}</simple>
                </setBody>
                <setHeader name="CamelHttpResponseCode">
                    <constant>200</constant>
                </setHeader>
            </otherwise>
        </choice>
    </route>

</camel>